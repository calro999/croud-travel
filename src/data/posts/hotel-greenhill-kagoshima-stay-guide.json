lex flex-wrap items-center justify-between border-b border-stone-200 pb-4 gap-3\">\n    <div>\n      <span class=\"inline-block px-3 py-1 bg-red-600 text-white font-black text-[11px] rounded-full mb-1.5\">📡 楽天トラベル公式API 連携施設データ</span>\n      <h2 class=\"text-lg md:text-xl font-extrabold text-stone-900\">天然温泉かけ流し　絹肌の湯　シルクイン鹿児島 施設スペック＆リアルタイム評価</h2>\n    </div>\n    <div class=\"flex items-center gap-2\">\n      <span class=\"px-3 py-1.5 bg-amber-50 border border-amber-300 text-amber-900 font-black text-xs rounded-xl\">⭐ 総合評価 4.36（口コミ 2287件）</span>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-start\">\n    <div class=\"md:col-span-5 space-y-3\">\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/8940/8940.jpg\" alt=\"天然温泉かけ流し　絹肌の湯　シルクイン鹿児島 外観・メインイメージ\" class=\"w-full h-52 object-cover rounded-2xl border border-stone-200 shadow-2xs\" loading=\"lazy\" />\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/8940/8940_twn.jpg\" alt=\"天然温泉かけ流し　絹肌の湯　シルクイン鹿児島 客室・館内イメージ\" class=\"w-full h-44 object-cover rounded-2xl border border-stone-200 shadow-2xs\" loading=\"lazy\" />\n    </div>\n    <div class=\"md:col-span-7 space-y-3\">\n      <div class=\"overflow-x-auto rounded-2xl border border-stone-200\">\n        <table class=\"w-full text-left border-collapse text-xs\">\n          <tbody class=\"divide-y divide-stone-200 bg-white\">\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900 w-32\">正式名称</th>\n              <td class=\"p-3 font-bold text-stone-900\">天然温泉かけ流し　絹肌の湯　シルクイン鹿児島 （施設番号: 8940）</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">所在地・住所</th>\n              <td class=\"p-3\">鹿児島県鹿児島市上之園町19-30</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">交通アクセス</th>\n              <td class=\"p-3\">ＪＲ鹿児島中央駅より徒歩5分/鹿児島空港より空港連絡バスで約50分→鹿児島中央ターミナルビル下車→徒歩1分</td>\n        