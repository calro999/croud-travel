-2 gap-4\">\n    <!-- 温泉・お風呂 -->\n    <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          ♨️ 温泉・お風呂\n        </h4>\n        <span class=\"text-2xs font-extrabold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200\">お風呂 ★ 4.47 / 5.0</span>\n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leading-relaxed font-medium\">\n        <li><strong>設備:</strong> 大浴場・人工温泉</li>\n        \n        \n      </ul>\n    </div>\n\n    <!-- お食事・グルメ -->\n    <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          🍽️ お食事スタイル・こだわり\n        </h4>\n        <span class=\"text-2xs font-extrabold text-orange-700 bg-orange-50 px-2 py-0.5 rounded-md border border-orange-200\">夕食★4 / 朝食★4.75</span>\n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leading-relaxed font-medium\">\n        <li><strong>朝食:</strong> レストラン(バイキング)</li>\n        <li><strong>夕食:</strong> 広間 / 食堂</li>\n        <li><strong>宿の特長:</strong> 旧軽銀座と高級別荘地に面し、ショッピングに散歩に最適。軽井沢らしい洋風感覚の旅館。</li>\n      </ul>\n    </div>\n\n    <!-- 駐車場・アクセス -->\n    <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          🚗 駐車場・交通アクセス\n        </h4>\n        <span class=\"text-2xs font-extrabold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200\">立地 ★4.93</span>\n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leading-rela