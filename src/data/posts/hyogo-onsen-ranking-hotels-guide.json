uten.co.jp%2FHOTEL%2F138019%2F138019.html\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"inline-block px-5 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold text-xs rounded-xl shadow hover:opacity-95 transition\">\n        楽天トラベルで宿泊プラン・空室を見る ≫\n      </a>\n    </div>\n  </div>\n  <div class=\"p-4 bg-white rounded-2xl border border-stone-200 shadow-2xs space-y-2\">\n    <div class=\"flex flex-col md:flex-row gap-3 items-center\">\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/8766/8766.jpg\" alt=\"城崎温泉　つちや旅館\" class=\"w-full md:w-36 h-24 object-cover rounded-xl shadow-inner flex-shrink-0\" loading=\"lazy\" />\n      <div class=\"flex-grow space-y-1\">\n        <div class=\"flex items-center gap-2\">\n          <span class=\"px-2 py-0.5 bg-amber-600 text-white font-black text-[10px] rounded-md\">第10位</span>\n          <h4 class=\"font-bold text-stone-900 text-sm leading-snug\">城崎温泉　つちや旅館</h4>\n        </div>\n        <p class=\"text-[11px] text-stone-600\">📍 兵庫県豊岡市城崎町湯島573 ｜ 🚃【電車】JR城崎温泉駅から旅館組合無料乗合バスで5～10分【車】北近畿豊岡自動車道・豊岡出石ICから約20分　無料Pあり</p>\n        <div class=\"flex items-center gap-3 text-xs text-stone-700\">\n          <span class=\"text-amber-600 font-bold\">⭐ 4.66（247件）</span>\n          <span class=\"font-bold text-stone-900\">目安: ¥13,200〜</span>\n        </div>\n      </div>\n    </div>\n    <p class=\"text-xs text-stone-700 bg-stone-50 p-2 rounded-lg border border-stone-100\">2025温泉宿総選挙全国第3位　 但馬牛をはじめ、旬を極める料理旅館</p>\n    <div class=\"text-right pt-1\">\n      <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2FHOTEL%2F8766%2F8766.html\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"inline-block px-5 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold text-xs rounded-xl shadow hover:opacity-95 transition\">\n        楽天トラベルで宿泊プラン・空室を見る ≫\n      </a>\n    </div>\n  </div>\n</div>\n<div class=\"pt-6 text-ce