ems-center justify-between border-b border-sky-300/40 pb-3\">\n    <span class=\"text-xs font-black text-sky-900 bg-sky-200 px-3 py-1 rounded-full uppercase\">👑 厳選リゾート 第4位</span>\n    <span class=\"text-[11px] font-bold text-sky-800\">⭐ None / 5.0</span>\n  </div>\n  <div class=\"flex flex-col md:flex-row gap-4\">\n    <div class=\"w-full md:w-1/3\">\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/191787/191787.jpg\" alt=\"ブルーシャローズ恩納村リゾート\" class=\"w-full h-auto rounded-xl shadow-md border border-sky-200\" loading=\"lazy\" />\n    </div>\n    <div class=\"w-full md:w-2/3 space-y-2\">\n      <h3 class=\"text-lg font-black font-journal-serif text-sky-950\">ブルーシャローズ恩納村リゾート</h3>\n      <p class=\"text-xs text-sky-950/80 leading-relaxed font-medium\">\n        恩納村の海辺に立地するホテル。海が一望できるプライベートプール付のお部屋もございます\n      </p>\n      <div class=\"text-sm font-bold text-sky-700 mt-2\">\n        💰 最安料金目安：¥要確認〜\n      </div>\n    </div>\n  </div>\n  <div class=\"pt-4 text-right\">\n    <a href=\"https://img.travel.rakuten.co.jp/image/tr/api/kw/JBe8h/?f_no=191787\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-6 py-3 bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white font-extrabold text-xs rounded-xl shadow transition\">\n      🏨 ブルーシャローズ恩納村リゾートのプラン・空室を見る\n    </a>\n  </div>\n</div>\n\n<div class=\"my-8 p-6 rounded-3xl bg-gradient-to-br from-sky-500/10 via-cyan-500/10 to-blue-500/10 border border-sky-400/40 shadow-sm space-y-4\">\n  <div class=\"flex items-center justify-between border-b border-sky-300/40 pb-3\">\n    <span class=\"text-xs font-black text-sky-900 bg-sky-200 px-3 py-1 rounded-full uppercase\">👑 厳選リゾート 第5位</span>\n    <span class=\"text-[11px] font-bold text-sky-800\">⭐ 4.02 / 5.0</span>\n  </div>\n  <div class=\"flex flex-col md:flex-row gap-4\">\n    <div class=\"w-full md:w-1/3\">\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/14275/14275.jpg\" alt=\"沖縄かりゆしビーチリゾート・オーシャンスパ\" cla