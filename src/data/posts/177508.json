-3 flex flex-col md:flex-row md:items-center md:justify-between gap-2\">\n    <div>\n      <h3 class=\"text-lg md:text-xl font-bold text-stone-900 flex items-center gap-2\">\n        🏨 Ｙｕ　Ｋｉｒｏｒｏ（ユキロロ） 宿泊前に知っておきたい詳細スペック＆設備\n      </h3>\n      <p class=\"text-xs text-stone-600 mt-1\">Ｙｕ Ｋｉｒｏｒｏ（ユキロロ）のお風呂・お食事・館内設備・アクセス情報の詳細ガイド</p>\n    </div>\n    <span class=\"inline-block px-3 py-1 bg-amber-100 text-amber-900 font-extrabold text-xs rounded-full border border-amber-300\">総合評価 ⭐ 4.56 (18件)</span>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n    <!-- 温泉・お風呂 -->\n    <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          ♨️ 温泉・お風呂\n        </h4>\n        \n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leading-relaxed font-medium\">\n        <li><strong>設備:</strong> 温泉・大浴場・露天風呂・サウナ・家族風呂・天然温泉</li>\n        <li><strong>泉質:</strong> 硫酸塩泉・塩化物泉・ナトリウム泉</li>\n        <li><strong>効能:</strong> 関節痛・筋肉痛・神経痛</li>\n      </ul>\n    </div>\n\n    <!-- お食事・グルメ -->\n    <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          🍽️ お食事スタイル・こだわり\n        </h4>\n        <span class=\"text-2xs font-extrabold text-orange-700 bg-orange-50 px-2 py-0.5 rounded-md border border-orange-200\">夕食★4.2 / 朝食★4.57</span>\n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leading-relaxed font-medium\">\n        <li><strong>朝食:</strong> レストラン</li>\n        <li><strong>夕食:</strong> レストラン</li>\n        <li><strong>宿の特長:</strong> 小樽から車で40分◆静かな森の別荘で暮らすように泊まる◆全室キッチン付きスイートタイプ</li>\n      </ul>\n    </div>\n\n    <!-- 駐車場・アクセス -->\n    <di