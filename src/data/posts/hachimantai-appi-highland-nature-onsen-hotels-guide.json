"flex items-center gap-2\">\n      <span class=\"px-3 py-1.5 bg-amber-50 border border-amber-300 text-amber-900 font-black text-xs rounded-xl\">⭐ 総合評価 4.33（口コミ 815件）</span>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-start\">\n    <div class=\"md:col-span-5 space-y-3\">\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/1702/1702.jpg\" alt=\"八幡平マウンテンホテル 外観・メインイメージ\" class=\"w-full h-52 object-cover rounded-2xl border border-stone-200 shadow-2xs\" loading=\"lazy\" />\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/1702/1702_y.jpg\" alt=\"八幡平マウンテンホテル 客室・館内イメージ\" class=\"w-full h-44 object-cover rounded-2xl border border-stone-200 shadow-2xs\" loading=\"lazy\" />\n    </div>\n    <div class=\"md:col-span-7 space-y-3\">\n      <div class=\"overflow-x-auto rounded-2xl border border-stone-200\">\n        <table class=\"w-full text-left border-collapse text-xs\">\n          <tbody class=\"divide-y divide-stone-200 bg-white\">\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900 w-32\">正式名称</th>\n              <td class=\"p-3 font-bold text-stone-900\">八幡平マウンテンホテル （施設番号: 1702）</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">所在地・住所</th>\n              <td class=\"p-3\">岩手県八幡平市松尾寄木第1地割509-1</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">交通アクセス</th>\n              <td class=\"p-3\">東北自動車道 松尾ICより15分。盛岡駅より岩手県北バスで約80分。（最寄り：盛岡駅）</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">駐車場情報</th>\n              <td class=\"p-3\">有り　200台　無料　先着順</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">参考最安料金</th>\n              <td class=\"p-3 font-extrabold text-red-600 text-sm\">¥5,500〜 <span class=\"text-[11px] font-normal text-stone-500\">（※季節・曜日