justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-sky-700\">¥8,400〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Fimg.travel.rakuten.co.jp%2Fimage%2Ftr%2Fapi%2Fkw%2F3VTwt%2F%3Ff_no%3D13483%26f_flg%3DPLAN\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"px-4 py-2 text-xs font-bold text-white rounded-xl transition bg-sky-700 hover:bg-sky-800\">\n            楽天トラベルで送迎・空室を確認 →\n          </a>\n        </div>\n      </div>\n\n      <div class=\"rounded-2xl border border-sky-200 bg-white overflow-hidden shadow-xs flex flex-col justify-between\">\n        <div class=\"flex flex-col sm:flex-row gap-4 p-4\">\n          <div class=\"sm:w-2/5 shrink-0\">\n            <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/106199/106199.jpg\" alt=\"鳴子温泉　名湯の宿　鳴子ホテルの雪見温泉イメージ\" class=\"w-full h-40 object-cover rounded-xl border border-stone-200\" loading=\"lazy\" />\n          </div>\n          <div class=\"flex-1 space-y-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\">\n              <span class=\"text-[10px] font-black px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-900\">\n                電車コスパ枠\n              </span>\n              <span class=\"text-xs font-black text-amber-700\">★ 4.43（風呂★4.63）</span>\n            </div>\n            <h5 class=\"font-extrabold text-stone-900 text-sm md:text-base leading-snug\">鳴子温泉 名湯の宿 鳴子ホテル</h5>\n            <p class=\"text-[11px] font-bold text-sky-900 bg-sky-50/80 border border-sky-200/70 rounded-lg px-2.5 py-1.5\">\n              電車・バス経路：JR鳴子温泉駅より徒歩にて５分。仙台駅から古川駅経由で電車で60分。\n            </p>\n            <p class=\"text-xs text-stone-700 leading-relaxed\">JR陸羽東線・鳴子温泉駅から徒歩約5分という電車派に優しい名宿。天候や時刻によって多彩に表情を変える自家源泉と、宮城の旬を揃えた食事が高評価で、冬の一人旅・夫婦旅どちらにも人気です。</p>\n          </div>\n        </div>\n        <div class=\"px-4 py-3 bg-stone-50 border-t border-stone-100 flex items-center justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-sky-700\">¥9,900〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Fimg.travel.rakuten.co.jp%2Fimage%2Ftr%2Fapi%2Fkw%2F3VTwt%2F%3Ff_no%3D106199%26f_flg%3DPLAN\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"px-4 py-2 text-xs font-bold text-white rounded-xl transition bg-sky-700 hover:bg-sky-800\">\n            楽天トラベルで送迎・空室を確認 →\n          </a>\n        </div>\n      </div>\n  </div>\n\n  <div class=\"space-y-4 my-6\">\n    <h4 class=\"font-extrabold text-indigo-950 text-base\">移動の疲れゼロで秘湯へ！冬の贅沢・ご褒美雪見宿（2軒）</h4>\n    \n      <div class=\"rounded-2xl border border-indigo-200 bg-white overflow-hidden shadow-xs flex flex-col justify-between\">\n        <div class=\"flex flex-col sm:flex-row gap-4 p-4\">\n          <div class=\"sm:w-2/5 shrink-0\">\n            <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/147944/147944.jpg\" alt=\"鶴の湯別館　山の宿の雪見温泉イメージ\" class=\"w-full h-40 object-cover rounded-xl border border-stone-200\" loading=\"lazy\" />\n          </div>\n          <div class=\"flex-1 space-y-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\">\n              <span class=\"text-[10px] font-black px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-900\">\n                極上ご褒美枠\n              </span>\n              <span class=\"text-xs font-black text-amber-700\">★ 4.92（風呂★-）</span>\n            </div>\n            <h5 class=\"font-extrabold text-stone-900 text-sm md:text-base leading-snug\">鶴の湯別館 山の宿</h5>\n            <p class=\"text-[11px] font-bold text-sky-900 bg-sky-50/80 border border-sky-200/70 rounded-lg px-2.5 py-1.5\">\n              電車・バス経路：田沢湖駅より路線バス乳頭線で約４０分「アルパこまくさ」下車後、送迎車で約10分（要予約）。\n            </p>\n            <p class=\"text-xs text-stone-700 leading-relaxed\">田沢湖駅から乳頭線バスで約40分＋バス停「アルパこまくさ」から送迎約10分（要予約）。秘湯ファン憧れの鶴の湯別館は評価4.92と圧倒的で、囲炉裏料理と極上の湯治情緒を静かに堪能できます。</p>\n          </div>\n        </div>\n        <div class=\"px-4 py-3 bg-stone-50 border-t border-stone-100 flex items-center justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-indigo-800\">¥17,600〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Fimg.travel.rakuten.co.jp%2Fimage%2Ftr%2Fapi%2Fkw%2F3VTwt%2F%3Ff_no%3D147944%26f_flg%3DPLAN\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"px-4 py-2 text-xs font-bold text-white rounded-xl transition bg-indigo-700 hover:bg-indigo-800\">\n            楽天トラベルで送迎・空室を確認 →\n          </a>\n        </div>\n      </div>\n\n      <div class=\"rounded-2xl border border-indigo-200 bg-white overflow-hidden shadow-xs flex flex-col justify-between\">\n        <div class=\"flex flex-col sm:flex-row gap-4 p-4\">\n          <div class=\"sm:w-2/5 shrink-0\">\n            <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/13482/13482.jpg\" alt=\"花巻温泉　佳松園の雪見温泉イメージ\" class=\"w-full h-40 object-cover rounded-xl border border-stone-200\" loading=\"lazy\" />\n          </div>\n          <div class=\"flex-1 space-y-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\">\n              <span class=\"text-[10px] font-black px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-900\">\n                極上ご褒美枠\n              </span>\n              <span class=\"text-xs font-black text-amber-700\">★ 4.67（風呂★4.77）</span>\n            </div>\n            <h5 class=\"font-extrabold text-stone-900 text-sm md:text-base leading-snug\">花巻温泉 佳松園</h5>\n            <p class=\"text-[11px] font-bold text-sky-900 bg-sky-50/80 border border-sky-200/70 rounded-lg px-2.5 py-1.5\">\n              電車・バス経路：花巻IC：右折後直進4km（5分）、JR新花巻駅・JR花巻駅：無料送迎バス20分（定時運行・完全予約制）\n            </p>\n            <p class=\"text-xs text-stone-700 leading-relaxed\">花巻温泉の奥に静かに佇む和風迎賓宿。とろりとした「美人の湯」の露天風呂からは冬の松林を眺められ、新花巻駅からの無料送迎付きで高齢の両親を連れた冬旅にも選ばれています。</p>\n          </div>\n        </div>\n        <div class=\"px-4 py-3 bg-stone-50 border-t border-stone-100 flex items-center justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-indigo-800\">¥18,700〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Fimg.travel.rakuten.co.jp%2Fimage%2Ftr%2Fapi%2Fkw%2F3VTwt%2F%3Ff_no%3D13482%26f_flg%3DPLAN\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"px-4 py-2 text-xs font-bold text-white rounded-xl transition bg-indigo-700 hover:bg-indigo-800\">\n            楽天トラベルで送迎・空室を確認 →\n          </a>\n        </div>\n      </div>\n  </div>\n</section>\n\n<section id=\"yk-hokkaido\" class=\"my-10 scroll-mt-6 border-b border-stone-200 pb-10\">\n  <div class=\"border-b-2 border-sky-900 pb-3 mb-5\">\n    <span class=\"text-[11px] font-black text-sky-900 bg-sky-100 px-2.5 py-0.5 rounded-full inline-block mb-1.5\">新千歳空港・JR札幌駅から送迎/路線バス（レンタカー不要）</span>\n    <h3 class=\"text-xl md:text-2xl font-black text-stone-900\">北海道（定山渓・登別）｜札幌発の送迎バスで楽しむパウダースノー露天</h3>\n    <p class=\"text-xs md:text-sm text-stone-600 mt-1.5 leading-relaxed\">冬の北海道こそ雪道運転を避けたいエリアナンバーワン。幸い札幌の奥座敷・定山渓温泉は主要宿が札幌発着の無料・有料送迎バスを運行しており、登別温泉も新千歳空港やJR登別駅からのバス網が万全です。</p>\n  </div>\n\n  <div class=\"space-y-4 my-4\">\n    <h4 class=\"font-extrabold text-sky-900 text-base\">浮いた高速・レンタカー代で楽しめる！駅近・送迎コスパ枠（2軒）</h4>\n    \n      <div class=\"rounded-2xl border border-sky-200 bg-white overflow-hidden shadow-xs flex flex-col justify-between\">\n        <div class=\"flex flex-col sm:flex-row gap-4 p-4\">\n          <div class=\"sm:w-2/5 shrink-0\">\n            <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/20619/20619.jpg\" alt=\"定山渓万世閣ホテルミリオーネの雪見温泉イメージ\" class=\"w-full h-40 object-cover rounded-xl border border-stone-200\" loading=\"lazy\" />\n          </div>\n          <div class=\"flex-1 space-y-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\">\n              <span class=\"text-[10px] font-black px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-900\">\n                電車コスパ枠\n              </span>\n              <span class=\"text-xs font-black text-amber-700\">★ 4.1（風呂★4.21）</span>\n            </div>\n            <h5 class=\"font-extrabold text-stone-900 text-sm md:text-base leading-snug\">定山渓万世閣ホテルミリオーネ</h5>\n            <p class=\"text-[11px] font-bold text-sky-900 bg-sky-50/80 border border-sky-200/70 rounded-lg px-2.5 py-1.5\">\n              電車・バス経路：地下鉄真駒内駅→じょうてつバス「定山渓車庫行き」定山渓停留所下車／札幌市内～国道230号線南下で約50分\n            </p>\n            <p class=\"text-xs text-stone-700 leading-relaxed\">地下鉄真駒内駅や札幌方面からのじょうてつバスで直行できる定番大型ホテル。広大な露天風呂からは定山渓の雪山を見渡せ、道産食材を使ったライブキッチンビュッフェも家族旅行で大人気です。</p>\n          </div>\n        </div>\n        <div class=\"px-4 py-3 bg-stone-50 border-t border-stone-100 flex items-center justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-sky-700\">¥10,353〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Fimg.travel.rakuten.co.jp%2Fimage%2Ftr%2Fapi%2Fkw%2F3VTwt%2F%3Ff_no%3D20619%26f_flg%3DPLAN\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"px-4 py-2 text-xs font-bold text-white rounded-xl transition bg-sky-700 hover:bg-sky-800\">\n            楽天トラベルで送迎・空室を確認 →\n          </a>\n        </div>\n      </div>\n\n      <div class=\"rounded-2xl border border-sky-200 bg-white overflow-hidden shadow-xs flex flex-col justify-between\">\n        <div class=\"flex flex-col sm:flex-row gap-4 p-4\">\n          <div class=\"sm:w-2/5 shrink-0\">\n            <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/28637/28637.jpg\" alt=\"登別温泉　登別万世閣の雪見温泉イメージ\" class=\"w-full h-40 object-cover rounded-xl border border-stone-200\" loading=\"lazy\" />\n          </div>\n          <div class=\"flex-1 space-y-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\">\n              <span class=\"text-[10px] font-black px-2.5 py-0.5 rounded-full bg-sky-100 text-sky-900\">\n                電車コスパ枠\n              </span>\n              <span class=\"text-xs font-black text-amber-700\">★ 4.01（風呂★3.94）</span>\n            </div>\n            <h5 class=\"font-extrabold text-stone-900 text-sm md:text-base leading-snug\">登別温泉 登別万世閣</h5>\n            <p class=\"text-[11px] font-bold text-sky-900 bg-sky-50/80 border border-sky-200/70 rounded-lg px-2.5 py-1.5\">\n              電車・バス経路：JR登別駅より登別温泉行バス終点下車徒歩目の前\n            </p>\n            <p class=\"text-xs text-stone-700 leading-relaxed\">JR登別駅から登別温泉行きバスの終点下車すぐ目の前。名物の硫黄泉をたたえた大浴場・露天風呂で北海道ならではの白濁湯をたっぷり浴びつつ、手頃な予算に収まるバランスの良さが光ります。</p>\n          </div>\n        </div>\n        <div class=\"px-4 py-3 bg-stone-50 border-t border-stone-100 flex items-center justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-sky-700\">¥12,423〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Fimg.travel.rakuten.co.jp%2Fimage%2Ftr%2Fapi%2Fkw%2F3VTwt%2F%3Ff_no%3D28637%26f_flg%3DPLAN\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"px-4 py-2 text-xs font-bold text-white rounded-xl transition bg-sky-700 hover:bg-sky-800\">\n            楽天トラベルで送迎・空室を確認 →\n          </a>\n        </div>\n      </div>\n  </div>\n\n  <div class=\"space-y-4 my-6\">\n    <h4 class=\"font-extrabold text-indigo-950 text-base\">移動の疲れゼロで秘湯へ！冬の贅沢・ご褒美雪見宿（2軒）</h4>\n    \n      <div class=\"rounded-2xl border border-indigo-200 bg-white overflow-hidden shadow-xs flex flex-col justify-between\">\n        <div class=\"flex flex-col sm:flex-row gap-4 p-4\">\n          <div class=\"sm:w-2/5 shrink-0\">\n            <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/875/875.jpg\" alt=\"定山渓温泉　定山渓第一寶亭留　翠山亭の雪見温泉イメージ\" class=\"w-full h-40 object-cover rounded-xl border border-stone-200\" loading=\"lazy\" />\n          </div>\n          <div class=\"flex-1 space-y-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\">\n              <span class=\"text-[10px] font-black px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-900\">\n                極上ご褒美枠\n              </span>\n              <span class=\"text-xs font-black text-amber-700\">★ 4.48（風呂★4.44）</span>\n            </div>\n            <h5 class=\"font-extrabold text-stone-900 text-sm md:text-base leading-snug\">定山渓温泉 定山渓第一寶亭留 翠山亭</h5>\n            <p class=\"text-[11px] font-bold text-sky-900 bg-sky-50/80 border border-sky-200/70 rounded-lg px-2.5 py-1.5\">\n              電車・バス経路：札幌より無料送迎バス運行（要予約）／ＪＲ札幌駅より車で60分／新千歳空港より車で約2時間\n            </p>\n            <p class=\"text-xs text-stone-700 leading-relaxed\">札幌中心部からの無料送迎バス（要予約）が利用できる定山渓の老舗ラグジュアリー宿。宿泊者専用の展望浴場や湯上がりラウンジが整い、吹雪の日でも一歩も出ずに大人の雪見籠りを堪能できます。</p>\n          </div>\n        </div>\n        <div class=\"px-4 py-3 bg-stone-50 border-t border-stone-100 flex items-center justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-indigo-800\">¥16,286〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Fimg.travel.rakuten.co.jp%2Fimage%2Ftr%2Fapi%2Fkw%2F3VTwt%2F%3Ff_no%3D875%26f_flg%3DPLAN\" target=\"_blank\" rel=\"sponsored noopener noreferrer\" class=\"px-4 py-2 text-xs font-bold text-white rounded-xl transition bg-indigo-700 hover:bg-indigo-800\">\n            楽天トラベルで送迎・空室を確認 →\n          </a>\n        </div>\n      </div>\n\n      <div class=\"rounded-2xl border border-indigo-200 bg-white overflow-hidden shadow-xs flex flex-col justify-between\">\n        <div class=\"flex flex-col sm:flex-row gap-4 p-4\">\n          <div class=\"sm:w-2/5 shrink-0\">\n            <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/30109/30109.jpg\" alt=\"登別温泉　第一滝本館の雪見温泉イメージ\" class=\"w-full h-40 object-cover rounded-xl border border-stone-200\" loading=\"lazy\" />\n          </div>\n          <div class=\"flex-1 space-y-2\">\n            <div class=\"flex flex-wrap items-center justify-between gap-2\">\n              <span class=\"text-[10px] font-black px-2.5 py-0.5 rounded-full bg-indigo-100 text-indigo-900\">\n                極上ご褒美枠\n              </span>\n              <span class=\"text-xs font-black text-amber-700\">★ 4.57（風呂★4.72）</span>\n            </div>\n            <h5 class=\"font-extrabold text-stone-900 text-sm md:text-base leading-snug\">登別温泉 第一滝本館</h5>\n            <p class=\"text-[11px] font-bold text-sky-900 bg-sky-50/80 border border-sky-200/70 rounded-lg px-2.5 py-1.5\">\n              電車・バス経路：JR登別駅よりバス又はタクシーで約15分／道央道登別東ＩＣから車で約10分／新千歳空港から車で約60分\n            </p>\n            <p class=\"text-xs text-stone-700 leading-relaxed\">地獄谷のすぐ目の前に建ち、5つの泉質・35もの浴槽が揃う「温泉のデパート」。大露天風呂から湯気越しに眺める地獄谷の冬景色は唯一無二で、冬北海道の旅のハイライトになります。</p>\n          </div>\n        </div>\n        <div class=\"px-4 py-3 bg-stone-50 border-t border-stone-100 flex items-center justify-between gap-3\">\n          <div>\n            <span class=\"text-[10px] text-stone-500\">最安参考料金（1名）：</span>\n            <span class=\"text-base font-black text-indigo-800\">¥14,200〜</span>\n          </div>\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=htt