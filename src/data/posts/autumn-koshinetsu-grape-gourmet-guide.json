adow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          ♨️ 温泉・お風呂\n        </h4>\n        <span class=\"text-2xs font-extrabold text-amber-700 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200\">お風呂 ★ 4.76 / 5.0</span>\n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leading-relaxed font-medium\">\n        <li><strong>設備:</strong> 温泉・大浴場・露天風呂・サウナ</li>\n        <li><strong>泉質:</strong> アルカリ単純泉</li>\n        <li><strong>効能:</strong> 関節痛・筋肉痛・神経痛</li>\n      </ul>\n    </div>\n\n    <!-- お食事・グルメ -->\n    <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          🍽️ 石和温泉 華やぎの章 慶山のお食事スタイルと料理のこだわり\n        </h4>\n        <span class=\"text-2xs font-extrabold text-orange-700 bg-orange-50 px-2 py-0.5 rounded-md border border-orange-200\">夕食★4.69 / 朝食★4.64</span>\n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leading-relaxed font-medium\">\n        <li><strong>朝食:</strong> レストラン(バイキング)</li>\n        <li><strong>夕食:</strong> 個室 / レストラン</li>\n        <li><strong>宿の特長:</strong> 石和温泉駅から徒歩で行ける好立地、県下最大の温泉郷の中にあって規模も施設も充実の館内</li>\n      </ul>\n    </div>\n\n    <!-- 駐車場・アクセス -->\n    <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-xs space-y-2\">\n      <div class=\"flex items-center justify-between border-b border-stone-100 pb-2\">\n        <h4 class=\"font-bold text-sm text-stone-900 flex items-center gap-1.5\">\n          🚗 駐車場・交通アクセス\n        </h4>\n        <span class=\"text-2xs font-extrabold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200\">立地 ★4.53</span>\n      </div>\n      <ul class=\"text-xs text-stone-700 space-y-1.5 leadi