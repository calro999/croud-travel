div>\n    <div class=\"flex items-center gap-2\">\n      <span class=\"px-3 py-1.5 bg-amber-50 border border-amber-300 text-amber-900 font-black text-xs rounded-xl\">⭐ 総合評価 4.17（口コミ 102件）</span>\n    </div>\n  </div>\n\n  <div class=\"grid grid-cols-1 md:grid-cols-12 gap-6 items-start\">\n    <div class=\"md:col-span-5 space-y-3\">\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/142874/142874.jpg\" alt=\"箱根強羅グアムドッグ本店 外観・メインイメージ\" class=\"w-full h-52 object-cover rounded-2xl border border-stone-200 shadow-2xs\" loading=\"lazy\" />\n      <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/142874/142874_kya.jpg\" alt=\"箱根強羅グアムドッグ本店 客室・館内イメージ\" class=\"w-full h-44 object-cover rounded-2xl border border-stone-200 shadow-2xs\" loading=\"lazy\" />\n    </div>\n    <div class=\"md:col-span-7 space-y-3\">\n      <div class=\"overflow-x-auto rounded-2xl border border-stone-200\">\n        <table class=\"w-full text-left border-collapse text-xs\">\n          <tbody class=\"divide-y divide-stone-200 bg-white\">\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900 w-32\">正式名称</th>\n              <td class=\"p-3 font-bold text-stone-900\">箱根強羅グアムドッグ本店 （施設番号: 142874）</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">所在地・住所</th>\n              <td class=\"p-3\">神奈川県足柄下郡箱根町強羅1322-20</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">交通アクセス</th>\n              <td class=\"p-3\">早雲山駅より徒歩にて１５分。ＪＲ　小田原駅より伊豆箱根バス「大涌谷経由湖尻行き」早雲山上バス停で下車、徒歩５分（最寄り：小田原駅）</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">駐車場情報</th>\n              <td class=\"p-3\">有り　４台　無料　予約不要</td>\n            </tr>\n            <tr>\n              <th class=\"p-3 bg-stone-50 font-bold text-stone-900\">参考最安料金</th>\n              <td class=\"p-3 font-extrabold text-red-600 text-sm\">¥22,770〜 <sp