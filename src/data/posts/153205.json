fy-between space-y-3\">\n        <div class=\"flex gap-3 items-start\">\n          <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/196259/196259.jpg\" alt=\"天然温泉スーパーホテルＰｒｅｍｉｅｒ富山・城址公園前 外観・客室\" class=\"w-24 h-20 object-cover rounded-xl shrink-0 border border-stone-100\" loading=\"lazy\" />\n          <div class=\"space-y-1 text-xs\">\n            <span class=\"inline-block px-2 py-0.5 bg-amber-100 text-amber-900 font-bold text-[10px] rounded-md\">富山県 厳選比較 #3</span>\n            <h3 class=\"font-bold text-stone-900 text-xs md:text-sm leading-snug\">天然温泉スーパーホテルＰｒｅｍｉｅｒ富山・城址公園前</h3>\n            <p class=\"text-[11px] text-stone-500\">📍 富山県富山市総曲輪1-1-21 ／ 🚃 富山</p>\n            <p class=\"text-[11px] font-bold text-amber-700\">⭐ 4.45（1222件） ／ 目安: ¥5,050〜</p>\n          </div>\n        </div>\n        <p class=\"text-[11px] text-stone-600 leading-relaxed bg-stone-50 p-2 rounded-lg\">焼立パンや地元食材が味わえる健康無料朝食にウェルカムバー、天然温泉でぐっすりお眠りください</p>\n        <div class=\"text-right\">\n          <a href=\"https://hb.afl.rakuten.co.jp/hgc/54d2a438.4bc4abc2.54d2a439.aa1be583/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2FHOTEL%2F196259%2F196259.html\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"inline-block px-4 py-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold text-[11px] rounded-xl shadow-2xs hover:opacity-95 transition\">\n            楽天トラベルで空室・料金を見る →\n          </a>\n        </div>\n      </div>\n\n      <div class=\"p-4 rounded-2xl bg-white border border-stone-200 shadow-2xs flex flex-col justify-between space-y-3\">\n        <div class=\"flex gap-3 items-start\">\n          <img src=\"https://img.travel.rakuten.co.jp/share/HOTEL/19097/19097.jpg\" alt=\"立山山麓温泉　ペンション愛花夢＜富山県＞ 外観・客室\" class=\"w-24 h-20 object-cover rounded-xl shrink-0 border border-stone-100\" loading=\"lazy\" />\n          <div class=\"space-y-1 text-xs\">\n            <span class=\"inline-block px-2 py-0.5 bg-amber-100 text-amber-900 font-bold text-[10px] rounded-md\">富山県 厳選比較 #4</span>\n 