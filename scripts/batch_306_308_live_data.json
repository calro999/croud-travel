    "wiki": {
      "ハウステンボス": {
        "title": "ハウステンボス",
        "extract": "ハウステンボス は、長崎県佐世保市にあるテーマパーク。略称は「HTB」、テンボス。オランダの街並みを再現し、ヨーロッパ全体をテーマとしている。東京ディズニーリゾートの1.5倍の敷地面積で、単独テーマパークとしては日本最大。ドラマ・映画・CMなどのロケ地としても使われている。佐世保市の町にもなっており、所在地の住所は「佐世保市ハウステンボス町（まち）1-1」。",
        "thumbnail": "https://thumb.wikimedia.org/wikipedia/commons/thumb/8/8b/Huis_Ten_Bosch_-_01.jpg/330px-Huis_Ten_Bosch_-_01.jpg?utm_source=ja.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
        "originalimage": "https://upload.wikimedia.org/wikipedia/commons/8/8b/Huis_Ten_Bosch_-_01.jpg?utm_source=ja.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled"
      },
      "佐世保市": {
        "title": "佐世保市",
        "extract": "佐世保市（させぼし、させほし）は、長崎県の北部地方にある市。長崎県北部の最大都市であり、県内では長崎市に次ぐ第二都市。中核市および保健所政令市の指定を受けている。",
        "thumbnail": "https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Sasebo_Montage1.jpg/330px-Sasebo_Montage1.jpg?utm_source=ja.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
        "originalimage": "https://upload.wikimedia.org/wikipedia/commons/0/0d/Sasebo_Montage1.jpg?utm_source=ja.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled"
      },
      "大村湾": {
        "title": "大村湾",
        "extract": "大村湾（おおむらわん）は、長崎県の中央部に位置する海。佐世保湾を通して五島灘に繋がる。穏やかな波が海岸に打ち寄せる様から「琴の湖」（ことのうみ）の別名があり、これは江戸期の漢学者・頼山陽が呼び始めたものと伝えられる。",
        "thumbnail": "https://thumb.wikimedia.org/wikipedia/commons/thumb/3/3f/Nishisonogi_and_Nagasaki_Peninsula_Japan_SRTM.jpg/330px-Nishisonogi_and_Nagasaki_Peninsula_Japan_SRTM.jpg?utm_source=ja.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
        "originalimage": "https://upload.wikimedia.org/wikipedia/commons/3/3f/Nishisonogi_and_Nagasaki_Peninsula_Japan_SRTM.jpg?utm_source=ja.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled"
      },
      "西海橋": {
        "title": "西海橋",
        "extract": "西海橋（さいかいばし）は、長崎県佐世保市針尾島と西海市西彼町の間にある伊ノ浦瀬戸（針尾瀬戸）に架かるアーチ橋である。完成当時は固定アーチ橋としては世界で三番目の長さを誇り、東洋一と評された。潮の流れが速く工事が困難な海峡での設計と使われた鋼橋製作・架設技術が卓越していたことから、戦後日本の長大橋建設の原点・日本の橋梁技術発展の起点と言われる。2020年に国の重要文化財に指定。",
        "thumbnail": "https://thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Saikai_bridge.JPG/330px-Saikai_bridge.JPG?utm_source=ja.wikipedia.org&utm_campaign=api&utm_content=thumbnail",
